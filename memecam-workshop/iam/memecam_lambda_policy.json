{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "GesturesTable",
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem",
        "dynamodb:UpdateItem",
        "dynamodb:Scan"
      ],
      "Resource": "<ARN_DE_LA_TABLA>"
    },
    {
      "Sid": "MemesBucket",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject"
      ],
      "Resource": "arn:aws:s3:::<NOMBRE_DEL_BUCKET>/memes/*"
    }
  ]
}
